      ],
      "kpis": [
        "medical loss ratio",
        "membership",
        "same-facility growth",
        "labor cost",
        "cash collections"
      ],
      "valuation": [
        "DCF",
        "normalized earnings",
        "EV/EBITDA with consistent lease treatment"
      ],
      "traps": [
        "mixing GAAP and adjusted metrics",
        "ignoring reporting lags",
        "treating proposed payment rules as final"
      ]
    },
    "tools-diagnostics": {
      "drivers": [
        "biopharma funding",
        "research and production spending",
        "instrument placement",
