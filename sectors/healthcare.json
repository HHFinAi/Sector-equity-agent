  "source_requests": [
    {
      "domain": "reported financials",
      "preferred": "SEC/issuer filings and original earnings materials",
      "request": "Dated filings, periods, KPI definitions, cash/debt/shares, guidance and prior comparables."
    },
    {
      "domain": "clinical evidence",
      "preferred": "ClinicalTrials.gov/protocol plus original trial results or publications",
      "request": "Registry identifier, version date, endpoints, populations, effect sizes, uncertainty and safety."
    },
    {
      "domain": "regulatory status",
      "preferred": "FDA/EMA or relevant regulator primary records",
      "request": "Current decision record, label, review status and documented next-event window."
    },
    {
      "domain": "reimbursement",
      "preferred": "CMS or relevant payer/HTA primary material",
      "request": "Policy version, proposal/final status, effective date, payment unit and covered population."
    },
    {
      "domain": "market expectations",
      "preferred": "Authorized Bloomberg/FactSet or other dated market-data export",
      "request": "Price timestamp, currency, diluted shares, consensus period and metric definitions; never assume access."
    },
    {
      "domain": "macro and policy",
      "preferred": "Central bank, official statistics and election authorities",
      "request": "Relevant meeting, inflation/employment release and election-policy risk dates verified at run time."
    }
  ]
}
