        "risk-adjusted pipeline value",
        "net cash and burn",
        "launch uptake and net price"
      ],
      "valuation": [
        "asset-level rNPV",
        "cash and corporate-cost bridge",
        "reverse probability/peak-sales assumptions"
      ],
